#include 'actions/calendar'
#include 'actions/text'
#include 'actions/math'

#define name AsaJitakuNativeCard2
#define color pink
#define glyph alarmClock
#define version 26

/* NativeCard2
   - NativeCardの見やすいネイティブメニューを維持
   - 毎晩の削除確認をなくすため、朝じたくアラームは削除せずOFF
   - 同じ時刻・同じパターンの既存アラームは再利用
   - 東二・出勤を 6:21 / 3分おき / 15回 に変更
*/

@baseMin = 0
@gap = 0
@count = 0
@offsetMin = 0
@patName = ""

menu "朝じたく" {
item "今夜のアラームをセット":
    menu "パターンを選んでください" {
    item "東二・出勤\n6:21 ・ 3分おき ・ 15回":
        @baseMin = 381
        @gap = 3
        @count = 15
        @patName = "東二・出勤"
    item "パシーナ・出勤\n5:55 ・ 3分おき ・ 10回":
        @baseMin = 355
        @gap = 3
        @count = 10
        @patName = "パシーナ・出勤"
    item "日曜日\n9:00 ・ 5分おき ・ 10回":
        @baseMin = 540
        @gap = 5
        @count = 10
        @patName = "日曜日"
    item "休日\nアラームなし":
        @baseMin = 0
        @gap = 0
        @count = 0
        @patName = "休日"
    item "モーニング\n7:30 ・ 5分おき ・ 10回":
        @baseMin = 450
        @gap = 5
        @count = 10
        @patName = "モーニング"
    item "平日登校日\n6:30 ・ 4分おき ・ 10回":
        @baseMin = 390
        @gap = 4
        @count = 10
        @patName = "平日登校日"
    }

    menu "今日だけ時刻をずらしますか？" {
    item "そのまま":
        @offsetMin = 0
    item "+5分":
        @offsetMin = 5
    item "+10分":
        @offsetMin = 10
    item "+15分":
        @offsetMin = 15
    item "+30分":
        @offsetMin = 30
    item "-5分":
        @offsetMin = -5
    item "-10分":
        @offsetMin = -10
    item "-15分":
        @offsetMin = -15
    item "-30分":
        @offsetMin = -30
    }

    @alarms = getAlarms()
    for alarm in @alarms {
        @rawName = getName(@alarm)
        @alarmName = getText(@rawName)
        if @alarmName beginsWith "朝じたく｜" {
            turnOffAlarm(@alarm, false)
        }
    }

    if @count > 0 {
        @totalBase = @baseMin + @offsetMin
        @made = 0
        repeat i for @count {
            @iZero = @i - 1
            @gapi = @gap * @iZero
            @thisMin = @totalBase + @gapi
            @hhRaw = @thisMin / 60
            @hh = floor(@hhRaw)
            @mmRaw = @hh * 60
            @mm = @thisMin - @mmRaw
            @hhPad = @hh
            if @hh < 10 { @hhPad = "0{@hh}" }
            @mmPad = @mm
            if @mm < 10 { @mmPad = "0{@mm}" }
            @timeText = "{@hhPad}:{@mmPad}"
            @targetName = "朝じたく｜{@patName}｜{@timeText}"

            @found = 0
            for existing in @alarms {
                @existingRawName = getName(@existing)
                @existingName = getText(@existingRawName)
                if @existingName == @targetName {
                    turnOnAlarm(@existing, false)
                    @found = 1
                }
            }
            if @found == 0 {
                createAlarm(@targetName, @timeText, false)
            }
            @made = @made + 1
        }
        alert("{@patName} を {@made}件 セットしました。", "朝じたく")
    } else {
        alert("休日：アラームなしにしました。", "朝じたく")
    }

item "起きました":
    @alarms2 = getAlarms()
    for alarm2 in @alarms2 {
        @rawName2 = getName(@alarm2)
        @alarmName2 = getText(@rawName2)
        if @alarmName2 beginsWith "朝じたく｜" {
            turnOffAlarm(@alarm2, false)
        }
    }
    alert("残りの朝じたくアラームを止めました。", "朝じたく")
}
