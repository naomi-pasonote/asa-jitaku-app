#include 'actions/calendar'
#include 'actions/text'
#include 'actions/math'

#define name AsaJitakuNative5
#define color pink
#define glyph alarmClock
#define version 26

/* このファイルはPublicリポジトリで公開される。
   Native5は日本語パターン名の文字化けを避けるため、6パターンをUTF-8で直接保持する。
   AsaJitakuNative4は変更していない(別ファイルとして新規作成)。
   AsaJitakuNative4からの変更点:
   ①「起きました」は停止(オフ)ではなく削除(delete)に変更
   ②off-by-one修正(最初のアラームが1間隔分ずれていたバグ)を適用 */

@baseMin = 0
@gap = 0
@count = 0
@offsetMin = 0
@patName = ""

menu "朝じたく" {
item "今夜のアラームをセット":
    menu "パターンを選んでください" {
    /* PATTERNS_START */
    item "東二・出勤":
        @baseMin = 381
        @gap = 3
        @count = 15
        @patName = "東二・出勤"
    item "パシーナ・出勤":
        @baseMin = 351
        @gap = 3
        @count = 15
        @patName = "パシーナ・出勤"
    item "日曜レッスン":
        @baseMin = 540
        @gap = 5
        @count = 10
        @patName = "日曜レッスン"
    item "休日":
        @baseMin = 0
        @gap = 0
        @count = 0
        @patName = "休日"
    item "モーニング":
        @baseMin = 450
        @gap = 5
        @count = 10
        @patName = "モーニング"
    item "平日登校日":
        @baseMin = 390
        @gap = 4
        @count = 10
        @patName = "平日登校日"
    /* PATTERNS_END */
    }
    menu "今日だけ時刻をずらしますか？" {
    item "そのまま":
        @offsetMin = 0
    item "+5分":
        @offsetMin = 5
    item "+10分":
        @offsetMin = 10
    item "+15分":
        @offsetMin = 15
    item "+30分":
        @offsetMin = 30
    item "-5分":
        @offsetMin = -5
    item "-10分":
        @offsetMin = -10
    item "-15分":
        @offsetMin = -15
    item "-30分":
        @offsetMin = -30
    }
    @alarms = getAlarms()
    @deleteList = []
    @deleteCount = 0
    for alarm in @alarms {
        @rawName = getName(@alarm)
        @alarmName = getText(@rawName)
        if @alarmName beginsWith "朝じたく｜" {
            @deleteList += @alarm
            @deleteCount = @deleteCount + 1
        }
    }
    if @deleteCount > 0 {
        deleteAlarm(@deleteList)
    }
    if @count > 0 {
        @totalBase = @baseMin + @offsetMin
        @made = 0
        repeat i for @count {
            @iZero = @i - 1
            @gapi = @gap * @iZero
            @thisMin = @totalBase + @gapi
            @hhRaw = @thisMin / 60
            @hh = floor(@hhRaw)
            @mmRaw = @hh * 60
            @mm = @thisMin - @mmRaw
            @hhPad = @hh
            if @hh < 10 {
                @hhPad = "0{@hh}"
            }
            @mmPad = @mm
            if @mm < 10 {
                @mmPad = "0{@mm}"
            }
            @timeText = "{@hhPad}:{@mmPad}"
            createAlarm("朝じたく｜{@patName}", @timeText, false)
            @made = @made + 1
        }
        alert("{@patName} を {@made}件 セットしました。", "朝じたく")
    } else {
        alert("休日：アラームなしにしました。", "朝じたく")
    }
item "起きました":
    @alarms2 = getAlarms()
    @deleteList2 = []
    @stopped = 0
    for alarm in @alarms2 {
        @rawName2 = getName(@alarm)
        @alarmName2 = getText(@rawName2)
        if @alarmName2 beginsWith "朝じたく｜" {
            @deleteList2 += @alarm
            @stopped = @stopped + 1
        }
    }
    if @stopped > 0 {
        deleteAlarm(@deleteList2)
    }
    alert("残りの朝じたくアラームを削除しました。", "朝じたく")
item "テスト（2・4・6分後）":
    @alarms3 = getAlarms()
    @deleteList3 = []
    @deleteCount3 = 0
    for alarm in @alarms3 {
        @rawName3 = getName(@alarm)
        @alarmName3 = getText(@rawName3)
        if @alarmName3 beginsWith "朝じたく｜" {
            @deleteList3 += @alarm
            @deleteCount3 = @deleteCount3 + 1
        }
    }
    if @deleteCount3 > 0 {
        deleteAlarm(@deleteList3)
    }
    @now = currentDate()
    @nowHtxt = formatDate(@now, "Custom", "HH")
    @nowMtxt = formatDate(@now, "Custom", "mm")
    @nowH = getNumbers(@nowHtxt)
    @nowM = getNumbers(@nowMtxt)
    @totalNow = (@nowH * 60) + @nowM
    repeat k for 3 {
        @kk = @k * 2
        @tmin = @totalNow + @kk
        @thhRaw = @tmin / 60
        @thhUnwrapped = floor(@thhRaw)
        @thh = @thhUnwrapped - 0
        if @thhUnwrapped > 23 {
            @thh = @thhUnwrapped - 24
        }
        @tmm = @tmin - (@thhUnwrapped * 60)
        @thhPad = @thh
        if @thh < 10 { @thhPad = "0{@thh}" }
        @tmmPad = @tmm
        if @tmm < 10 { @tmmPad = "0{@tmm}" }
        @testTimeText = "{@thhPad}:{@tmmPad}"
        createAlarm("朝じたく｜テスト", @testTimeText, false)
    }
    alert("2・4・6分後にテストアラームを3件セットしました。", "朝じたく")
}
