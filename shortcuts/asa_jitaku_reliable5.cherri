#include 'actions/calendar'
#include 'actions/text'
#include 'actions/math'

#define name AsaJitakuReliable5
#define color pink
#define glyph alarmClock
#define version 26

/* Reliable5: Web/clipboard/chooseFromList 不使用。
   パターン選択はネイティブ menu の各 item に直接処理を割り当てる。
   PATTERNSブロックは値だけを保持し、ビルド時にPATTERNS_CHERRIから注入する。 */

/* PATTERNS_START */
@p1Base = 420
@p1Gap = 5
@p1Count = 10
@p2Base = 480
@p2Gap = 5
@p2Count = 10
@p3Base = 540
@p3Gap = 5
@p3Count = 10
@p4Base = 0
@p4Gap = 0
@p4Count = 0
@p5Base = 450
@p5Gap = 5
@p5Count = 10
@p6Base = 390
@p6Gap = 4
@p6Count = 10
/* PATTERNS_END */

@baseMin = 0
@gap = 0
@count = 0
@offsetMin = 0
@patName = ""
@proceed = 0

menu "朝じたく" {
item "今夜のアラームをセット":
    @proceed = 0
    menu "パターンを選んでください" {
    item "東二・出勤":
        @baseMin = @p1Base
        @gap = @p1Gap
        @count = @p1Count
        @patName = "東二・出勤"
        @proceed = 1
    item "パシーナ・出勤":
        @baseMin = @p2Base
        @gap = @p2Gap
        @count = @p2Count
        @patName = "パシーナ・出勤"
        @proceed = 1
    item "日曜日":
        @baseMin = @p3Base
        @gap = @p3Gap
        @count = @p3Count
        @patName = "日曜日"
        @proceed = 1
    item "休日":
        @proceed = 0
        alert("休日：アラームなしにしました。", "朝じたく")
    item "モーニング":
        @baseMin = @p5Base
        @gap = @p5Gap
        @count = @p5Count
        @patName = "モーニング"
        @proceed = 1
    item "平日登校日":
        @baseMin = @p6Base
        @gap = @p6Gap
        @count = @p6Count
        @patName = "平日登校日"
        @proceed = 1
    }

    if @proceed == 1 {
        menu "今日だけ時刻をずらしますか？" {
        item "そのまま":
            @offsetMin = 0
        item "+5分":
            @offsetMin = 5
        item "+10分":
            @offsetMin = 10
        item "+15分":
            @offsetMin = 15
        item "+30分":
            @offsetMin = 30
        item "-5分":
            @offsetMin = -5
        item "-10分":
            @offsetMin = -10
        item "-15分":
            @offsetMin = -15
        item "-30分":
            @offsetMin = -30
        }

        @alarms = getAlarms()
        for alarm in @alarms {
            @rawName = getName(@alarm)
            @alarmName = getText(@rawName)
            if @alarmName beginsWith "朝じたく｜" {
                turnOffAlarm(@alarm, false)
            }
        }

        @totalBase = @baseMin + @offsetMin
        @made = 0
        repeat i for @count {
            @iZero = @i - 1
            @gapi = @gap * @iZero
            @thisMin = @totalBase + @gapi
            @hhRaw = @thisMin / 60
            @hh = floor(@hhRaw)
            @mmRaw = @hh * 60
            @mm = @thisMin - @mmRaw
            @hhPad = @hh
            if @hh < 10 { @hhPad = "0{@hh}" }
            @mmPad = @mm
            if @mm < 10 { @mmPad = "0{@mm}" }
            @timeText = "{@hhPad}:{@mmPad}"
            @targetName = "朝じたく｜{@patName}｜{@timeText}"
            @found = 0
            for existing in @alarms {
                @existingRawName = getName(@existing)
                @existingName = getText(@existingRawName)
                if @existingName == @targetName {
                    turnOnAlarm(@existing, false)
                    @found = 1
                }
            }
            if @found == 0 {
                createAlarm(@targetName, @timeText, false)
            }
            @made = @made + 1
        }
        alert("{@patName} を {@made}件 セットしました。", "朝じたく")
    }

item "起きました":
    @alarms2 = getAlarms()
    @stopped = 0
    for alarm2 in @alarms2 {
        @rawName2 = getName(@alarm2)
        @alarmName2 = getText(@rawName2)
        if @alarmName2 beginsWith "朝じたく｜" {
            turnOffAlarm(@alarm2, false)
            @stopped = @stopped + 1
        }
    }
    alert("残りの朝じたくアラームを止めました。", "朝じたく")
}
