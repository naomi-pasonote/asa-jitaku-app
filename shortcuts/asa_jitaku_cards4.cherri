#include 'actions/calendar'
#include 'actions/text'
#include 'actions/math'

#define name AsaJitakuCards4
#define color pink
#define glyph alarmClock
#define version 26

/* Cards4: 6つのパターンを複数行の一覧で選択する。
   古い朝じたくアラームは削除せずOFFにし、同じ時刻のアラームは再利用する。
   これにより、毎回の削除確認を避ける。 */

@baseMin = 0
@gap = 0
@count = 0
@offsetMin = 0
@patName = ""

@p1Name = "東二・出勤"
@p1Time = "6:21"
@p1Gap = 3
@p1Count = 15
@p1Base = 381

@p2Name = "パシーナ・出勤"
@p2Time = "5:45"
@p2Gap = 3
@p2Count = 20
@p2Base = 345

@p3Name = "日曜日"
@p3Time = "9:00"
@p3Gap = 5
@p3Count = 20
@p3Base = 540

@p4Name = "休日"
@p4Time = ""
@p4Gap = 0
@p4Count = 0
@p4Base = 0

@p5Name = "モーニング"
@p5Time = "7:30"
@p5Gap = 5
@p5Count = 20
@p5Base = 450

@p6Name = "平日登校日"
@p6Time = "6:30"
@p6Gap = 4
@p6Count = 20
@p6Base = 390

menu "朝じたく" {
item "今夜のアラームをセット":
    @p1Card = "{@p1Name}\n{@p1Time} ・ {@p1Gap}分おき ・ {@p1Count}回"
    @p2Card = "{@p2Name}\n{@p2Time} ・ {@p2Gap}分おき ・ {@p2Count}回"
    @p3Card = "{@p3Name}\n{@p3Time} ・ {@p3Gap}分おき ・ {@p3Count}回"
    @p4Card = "{@p4Name}\nアラームなし"
    @p5Card = "{@p5Name}\n{@p5Time} ・ {@p5Gap}分おき ・ {@p5Count}回"
    @p6Card = "{@p6Name}\n{@p6Time} ・ {@p6Gap}分おき ・ {@p6Count}回"

    @cardList = list(@p1Card, @p2Card, @p3Card, @p4Card, @p5Card, @p6Card)
    @chosenV = chooseFromList(@cardList, "パターンを選んでください")
    @chosen = getText(@chosenV)

    if @chosen == @p1Card {
        @baseMin = @p1Base
        @gap = @p1Gap
        @count = @p1Count
        @patName = @p1Name
    } else if @chosen == @p2Card {
        @baseMin = @p2Base
        @gap = @p2Gap
        @count = @p2Count
        @patName = @p2Name
    } else if @chosen == @p3Card {
        @baseMin = @p3Base
        @gap = @p3Gap
        @count = @p3Count
        @patName = @p3Name
    } else if @chosen == @p4Card {
        @baseMin = @p4Base
        @gap = @p4Gap
        @count = @p4Count
        @patName = @p4Name
    } else if @chosen == @p5Card {
        @baseMin = @p5Base
        @gap = @p5Gap
        @count = @p5Count
        @patName = @p5Name
    } else {
        @baseMin = @p6Base
        @gap = @p6Gap
        @count = @p6Count
        @patName = @p6Name
    }

    menu "今日だけ時刻をずらしますか？" {
    item "そのまま":
        @offsetMin = 0
    item "+5分":
        @offsetMin = 5
    item "+10分":
        @offsetMin = 10
    item "+15分":
        @offsetMin = 15
    item "+30分":
        @offsetMin = 30
    item "-5分":
        @offsetMin = -5
    item "-10分":
        @offsetMin = -10
    item "-15分":
        @offsetMin = -15
    item "-30分":
        @offsetMin = -30
    }

    @alarms = getAlarms()
    for alarm in @alarms {
        @rawName = getName(@alarm)
        @alarmName = getText(@rawName)
        if @alarmName beginsWith "朝じたく｜" {
            turnOffAlarm(@alarm, false)
        }
    }

    if @count > 0 {
        @totalBase = @baseMin + @offsetMin
        @made = 0
        repeat i for @count {
            @iZero = @i - 1
            @gapi = @gap * @iZero
            @thisMin = @totalBase + @gapi
            @hhRaw = @thisMin / 60
            @hh = floor(@hhRaw)
            @mmRaw = @hh * 60
            @mm = @thisMin - @mmRaw
            @hhPad = @hh
            if @hh < 10 {
                @hhPad = "0{@hh}"
            }
            @mmPad = @mm
            if @mm < 10 {
                @mmPad = "0{@mm}"
            }
            @timeText = "{@hhPad}:{@mmPad}"
            @targetName = "朝じたく｜{@patName}｜{@timeText}"
            @found = 0
            for existing in @alarms {
                @rawExistingName = getName(@existing)
                @existingName = getText(@rawExistingName)
                if @existingName == @targetName {
                    turnOnAlarm(@existing, false)
                    @found = @found + 1
                }
            }
            if @found == 0 {
                createAlarm(@targetName, @timeText, false)
            }
            @made = @made + 1
        }
        alert("{@patName} を {@made}件 セットしました。", "朝じたく")
    } else {
        alert("休日：アラームなしにしました。", "朝じたく")
    }

item "起きました":
    @alarms2 = getAlarms()
    @stopped = 0
    for alarm in @alarms2 {
        @rawName2 = getName(@alarm)
        @alarmName2 = getText(@rawName2)
        if @alarmName2 beginsWith "朝じたく｜" {
            turnOffAlarm(@alarm, false)
            @stopped = @stopped + 1
        }
    }
    alert("残りの朝じたくアラームを止めました。", "朝じたく")
}
