if @matched == 1 {
    @alarms = getAlarms()
    for alarm in @alarms {
        @rawName = getName(@alarm)
        @alarmName = getText(@rawName)
        if @alarmName beginsWith "朝じたく｜" {
            deleteAlarm(@alarm)
        }
    }
    if @count > 0 {
        @totalBase = @baseMin + @offsetMin
        @made = 0
        repeat i for @count {
            @gapi = @gap * @i
            @thisMin = @totalBase + @gapi
            @hhRaw = @thisMin / 60
            @hh = floor(@hhRaw)
            @mmRaw = @hh * 60
            @mm = @thisMin - @mmRaw
            @hhPad = @hh
            if @hh < 10 {
                @hhPad = "0{@hh}"
            }
            @mmPad = @mm
            if @mm < 10 {
                @mmPad = "0{@mm}"
            }
            @timeText = "{@hhPad}:{@mmPad}"
            createAlarm("朝じたく｜{@patName}", @timeText, false)
            @made = @made + 1
        }
        alert("{@patName} を {@made}件 セットしました。", "朝じたく")
    } else {
        alert("休日：アラームなしにしました。", "朝じたく")
    }
} else if @clip == "AJK:wake" {
    @alarms2 = getAlarms()
    @stopped = 0
    for alarm in @alarms2 {
        @rawName2 = getName(@alarm)
        @alarmName2 = getText(@rawName2)
        if @alarmName2 beginsWith "朝じたく｜" {
            turnOffAlarm(@alarm, false)
            @stopped = @stopped + 1
        }
    }
    alert("残りの朝じたくアラームを止めました。", "朝じたく")
} else {
    menu "朝じたく" {
    item "今夜のアラームをセット":
        @patListNames = list(@p1Name, @p2Name, @p3Name, @p4Name, @p5Name, @p6Name)
        @chosenNameV = chooseFromList(@patListNames, "パターンを選んでください")
        @chosenName = getText(@chosenNameV)
        if @chosenName == @p1Name {
            @baseMin = @p1Base
            @gap = @p1Gap
            @count = @p1Count
            @patName = @p1Name
        } else if @chosenName == @p2Name {
            @baseMin = @p2Base
            @gap = @p2Gap
            @count = @p2Count
            @patName = @p2Name
        } else if @chosenName == @p3Name {
            @baseMin = @p3Base
            @gap = @p3Gap
            @count = @p3Count
            @patName = @p3Name
        } else if @chosenName == @p4Name {
            @baseMin = @p4Base
            @gap = @p4Gap
            @count = @p4Count
            @patName = @p4Name
        } else if @chosenName == @p5Name {
            @baseMin = @p5Base
            @gap = @p5Gap
            @count = @p5Count
            @patName = @p5Name
        } else {
            @baseMin = @p6Base
            @gap = @p6Gap
            @count = @p6Count
            @patName = @p6Name
        }
        menu "今日だけ時刻をずらしますか？" {
        item "そのまま":
            @offsetMin = 0
        item "+5分":
            @offsetMin = 5
        item "+10分":
            @offsetMin = 10
        item "+15分":
            @offsetMin = 15
        item "+30分":
            @offsetMin = 30
        item "-5分":
            @offsetMin = -5
        item "-10分":
            @offsetMin = -10
        item "-15分":
            @offsetMin = -15
        item "-30分":
            @offsetMin = -30
        }
        @alarmsM = getAlarms()
        for alarm in @alarmsM {
            @rawNameM = getName(@alarm)
            @alarmNameM = getText(@rawNameM)
            if @alarmNameM beginsWith "朝じたく｜" {
                deleteAlarm(@alarm)
            }
        }
        if @count > 0 {
            @totalBaseM = @baseMin + @offsetMin
            @madeM = 0
            repeat j for @count {
                @gapjM = @gap * @j
                @thisMinM = @totalBaseM + @gapjM
                @hhRawM = @thisMinM / 60
                @hhM = floor(@hhRawM)
                @mmRawM = @hhM * 60
                @mmM = @thisMinM - @mmRawM
                @hhPadM = @hhM
                if @hhM < 10 {
                    @hhPadM = "0{@hhM}"
                }
                @mmPadM = @mmM
                if @mmM < 10 {
                    @mmPadM = "0{@mmM}"
                }
                @timeTextM = "{@hhPadM}:{@mmPadM}"
                createAlarm("朝じたく｜{@patName}", @timeTextM, false)
                @madeM = @madeM + 1
            }
            alert("{@patName} を {@madeM}件 セットしました。", "朝じたく")
        } else {
            alert("休日：アラームなしにしました。", "朝じたく")
        }
    item "起きました":
        @alarms3 = getAlarms()
        @stopped3 = 0
        for alarm in @alarms3 {
            @rawName3 = getName(@alarm)
            @alarmName3 = getText(@rawName3)
            if @alarmName3 beginsWith "朝じたく｜" {
                turnOffAlarm(@alarm, false)
                @stopped3 = @stopped3 + 1
            }
        }
        alert("残りの朝じたくアラームを止めました。", "朝じたく")
    item "テスト（2・4・6分後）":
        @alarms4 = getAlarms()
        for alarm in @alarms4 {
            @rawName4 = getName(@alarm)
            @alarmName4 = getText(@rawName4)
            if @alarmName4 beginsWith "朝じたく｜" {
                deleteAlarm(@alarm)
            }
        }
        @now = currentDate()
        @nowHtxt = formatDate(@now, "Custom", "HH")
        @nowMtxt = formatDate(@now, "Custom", "mm")
        @nowH = getNumbers(@nowHtxt)
        @nowM = getNumbers(@nowMtxt)
        @totalNow = (@nowH * 60) + @nowM
        repeat k for 3 {
            @kk = @k * 2
            @tmin = @totalNow + @kk
            @thhRaw = @tmin / 60
            @thhUnwrapped = floor(@thhRaw)
            @thh = @thhUnwrapped - 0
            if @thhUnwrapped > 23 {
                @thh = @thhUnwrapped - 24
            }
            @tmm = @tmin - (@thhUnwrapped * 60)
            @thhPad = @thh
            if @thh < 10 { @thhPad = "0{@thh}" }
            @tmmPad = @tmm
            if @tmm < 10 { @tmmPad = "0{@tmm}" }
            @testTimeText = "{@thhPad}:{@tmmPad}"
            createAlarm("朝じたく｜テスト", @testTimeText, false)
        }
        alert("2・4・6分後にテストアラームを3件セットしました。", "朝じたく")
    }
}