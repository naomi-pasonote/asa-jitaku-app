#include 'actions/calendar'
#include 'actions/text'
#include 'actions/math'
#include 'actions/sharing'

#define name AsaJitakuCards2
#define color pink
#define glyph alarmClock
#define version 26

/* このファイルはPublicリポジトリで公開される。個人のパターン名・時刻は含まない。
   実際の値は、ビルド時にリポジトリ シークレットの内容で下の PATTERNS ブロックが
   自動的に置き換えられてからコンパイル・署名される（AsaJitakuNative4 / AsaJitakuCards1
   と同じ仕組み）。AsaJitakuNative4 / AsaJitakuCards1 のアラーム作成・起きました処理は
   変更していない（同一ロジックをそのままコピー）。
   起動時にクリップボードのコード(AJK:<code>[:<offset>])を確認し、一致すればメニューを
   出さず直接その処理へ進む。一致しなければ従来どおりメニューを表示する。
   アラーム作成・停止の処理は、クリップボード経由でもメニュー経由でも1箇所だけに
   まとめてある(重複実装によるコンパイル後の肥大化を避けるため)。 */

/* PATTERNS_START */
@p1Name = "パターンA"
@p1Time = "7:00"
@p1Gap = 5
@p1Count = 10
@p1Base = 420
@p2Name = "パターンB"
@p2Time = "8:00"
@p2Gap = 5
@p2Count = 10
@p2Base = 480
@p3Name = "日曜日"
@p3Time = "9:00"
@p3Gap = 5
@p3Count = 10
@p3Base = 540
@p4Name = "休日"
@p4Time = ""
@p4Gap = 0
@p4Count = 0
@p4Base = 0
@p5Name = "パターンD"
@p5Time = "7:30"
@p5Gap = 5
@p5Count = 10
@p5Base = 450
@p6Name = "パターンE"
@p6Time = "6:30"
@p6Gap = 4
@p6Count = 10
@p6Base = 390
/* PATTERNS_END */

@baseMin = 0
@gap = 0
@count = 0
@offsetMin = 0
@patName = ""
@proceed = 0
@wake = 0

@clipV = getClipboard()
@clipRaw = getText(@clipV)
@clip = trimWhitespace(@clipRaw)
@parts = splitText(@clip, ":")
@partCount = count(@parts)

@codePart = ""
if @partCount > 1 {
    @codePartV = getListItem(@parts, 2)
    @codePart = getText(@codePartV)
}

@offsetPart = ""
if @partCount > 2 {
    @offsetPartV = getListItem(@parts, 3)
    @offsetPart = getText(@offsetPartV)
}

/* offsetは既知の文字列とだけ一致させる(ホワイトリスト方式)。それ以外・省略時は±0分 */
if @offsetPart == "+5" {
    @offsetMin = 5
} else if @offsetPart == "+10" {
    @offsetMin = 10
} else if @offsetPart == "+15" {
    @offsetMin = 15
} else if @offsetPart == "+30" {
    @offsetMin = 30
} else if @offsetPart == "-5" {
    @offsetMin = -5
} else if @offsetPart == "-10" {
    @offsetMin = -10
} else if @offsetPart == "-15" {
    @offsetMin = -15
} else if @offsetPart == "-30" {
    @offsetMin = -30
}

/* patternCodeの判定は6通りだけ */
if @codePart == "higashi2" {
    @baseMin = @p1Base
    @gap = @p1Gap
    @count = @p1Count
    @patName = @p1Name
    @proceed = 1
} else if @codePart == "pasina" {
    @baseMin = @p2Base
    @gap = @p2Gap
    @count = @p2Count
    @patName = @p2Name
    @proceed = 1
} else if @codePart == "sunday" {
    @baseMin = @p3Base
    @gap = @p3Gap
    @count = @p3Count
    @patName = @p3Name
    @proceed = 1
} else if @codePart == "holiday" {
    @baseMin = @p4Base
    @gap = @p4Gap
    @count = @p4Count
    @patName = @p4Name
    @proceed = 1
} else if @codePart == "morning" {
    @baseMin = @p5Base
    @gap = @p5Gap
    @count = @p5Count
    @patName = @p5Name
    @proceed = 1
} else if @codePart == "school" {
    @baseMin = @p6Base
    @gap = @p6Gap
    @count = @p6Count
    @patName = @p6Name
    @proceed = 1
} else if @codePart == "wake" {
    @wake = 1
} else {
    menu "朝じたく" {
    item "今夜のアラームをセット":
        @patListNames = list(@p1Name, @p2Name, @p3Name, @p4Name, @p5Name, @p6Name)
        @chosenNameV = chooseFromList(@patListNames, "パターンを選んでください")
        @chosenName = getText(@chosenNameV)
        if @chosenName == @p1Name {
            @baseMin = @p1Base
            @gap = @p1Gap
            @count = @p1Count
            @patName = @p1Name
        } else if @chosenName == @p2Name {
            @baseMin = @p2Base
            @gap = @p2Gap
            @count = @p2Count
            @patName = @p2Name
        } else if @chosenName == @p3Name {
            @baseMin = @p3Base
            @gap = @p3Gap
            @count = @p3Count
            @patName = @p3Name
        } else if @chosenName == @p4Name {
            @baseMin = @p4Base
            @gap = @p4Gap
            @count = @p4Count
            @patName = @p4Name
        } else if @chosenName == @p5Name {
            @baseMin = @p5Base
            @gap = @p5Gap
            @count = @p5Count
            @patName = @p5Name
        } else {
            @baseMin = @p6Base
            @gap = @p6Gap
            @count = @p6Count
            @patName = @p6Name
        }
        menu "今日だけ時刻をずらしますか？" {
        item "そのまま":
            @offsetMin = 0
        item "+5分":
            @offsetMin = 5
        item "+10分":
            @offsetMin = 10
        item "+15分":
            @offsetMin = 15
        item "+30分":
            @offsetMin = 30
        item "-5分":
            @offsetMin = -5
        item "-10分":
            @offsetMin = -10
        item "-15分":
            @offsetMin = -15
        item "-30分":
            @offsetMin = -30
        }
        @proceed = 1
    item "起きました":
        @wake = 1
    item "テスト（2・4・6分後）":
        @alarms4 = getAlarms()
        for alarm in @alarms4 {
            @rawName4 = getName(@alarm)
            @alarmName4 = getText(@rawName4)
            if @alarmName4 beginsWith "朝じたく｜" {
                deleteAlarm(@alarm)
            }
        }
        @now = currentDate()
        @nowHtxt = formatDate(@now, "Custom", "HH")
        @nowMtxt = formatDate(@now, "Custom", "mm")
        @nowH = getNumbers(@nowHtxt)
        @nowM = getNumbers(@nowMtxt)
        @totalNow = (@nowH * 60) + @nowM
        repeat k for 3 {
            @kk = @k * 2
            @tmin = @totalNow + @kk
            @thhRaw = @tmin / 60
            @thhUnwrapped = floor(@thhRaw)
            @thh = @thhUnwrapped - 0
            if @thhUnwrapped > 23 {
                @thh = @thhUnwrapped - 24
            }
            @tmm = @tmin - (@thhUnwrapped * 60)
            @thhPad = @thh
            if @thh < 10 { @thhPad = "0{@thh}" }
            @tmmPad = @tmm
            if @tmm < 10 { @tmmPad = "0{@tmm}" }
            @testTimeText = "{@thhPad}:{@tmmPad}"
            createAlarm("朝じたく｜テスト", @testTimeText, false)
        }
        alert("2・4・6分後にテストアラームを3件セットしました。", "朝じたく")
    }
}

/* --- ここから先は、クリップボード経由でもメニュー経由でも共通の1箇所だけの処理 --- */

if @proceed == 1 {
    @alarms = getAlarms()
    for alarm in @alarms {
        @rawName = getName(@alarm)
        @alarmName = getText(@rawName)
        if @alarmName beginsWith "朝じたく｜" {
            deleteAlarm(@alarm)
        }
    }
    if @count > 0 {
        @totalBase = @baseMin + @offsetMin
        @made = 0
        repeat i for @count {
            @iZero = @i - 1
            @gapi = @gap * @iZero
            @thisMin = @totalBase + @gapi
            @hhRaw = @thisMin / 60
            @hh = floor(@hhRaw)
            @mmRaw = @hh * 60
            @mm = @thisMin - @mmRaw
            @hhPad = @hh
            if @hh < 10 {
                @hhPad = "0{@hh}"
            }
            @mmPad = @mm
            if @mm < 10 {
                @mmPad = "0{@mm}"
            }
            @timeText = "{@hhPad}:{@mmPad}"
            createAlarm("朝じたく｜{@patName}", @timeText, false)
            @made = @made + 1
        }
        alert("{@patName} を {@made}件 セットしました。", "朝じたく")
    } else {
        alert("休日：アラームなしにしました。", "朝じたく")
    }
}

if @wake == 1 {
    @alarms2 = getAlarms()
    @stopped = 0
    for alarm in @alarms2 {
        @rawName2 = getName(@alarm)
        @alarmName2 = getText(@rawName2)
        if @alarmName2 beginsWith "朝じたく｜" {
            turnOffAlarm(@alarm, false)
            @stopped = @stopped + 1
        }
    }
    alert("残りの朝じたくアラームを止めました。", "朝じたく")
}