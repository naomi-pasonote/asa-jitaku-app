@p6Base = 390
/* PATTERNS_END */

@baseMin = 0
@gap = 0
@count = 0
@offsetMin = 0
@patName = ""

@clipV = getClipboard()
@clip = getText(@clipV)

@matched = 0

if @clip == "AJK:higashi2" {
    @baseMin = @p1Base
    @gap = @p1Gap
    @count = @p1Count
    @patName = @p1Name
    @offsetMin = 0
    @matched = 1
}
